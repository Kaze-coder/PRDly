# ─────────────────────────────────────────────
# AI PRD Generator — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Database (Supabase Postgres) ──
# Get from: Supabase Dashboard > Project Settings > Database > Connection string
# DATABASE_URL uses the pooled connection (port 6543), DIRECT_URL the direct one (5432)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase (Auth + Storage) ──
# Get from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ──
# Priority: 9Router > AgentRouter > OpenRouter (first configured key wins as fallback)

# 9Router — free-form model IDs, routes to 60+ providers
# Base URL default: https://api.9router.com/v1 (override with NINE_ROUTER_BASE_URL)
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=

# AgentRouter — fixed model: claude-opus-4-8
# Get from: https://agentrouter.org
AGENTROUTER_API_KEY=

# OpenRouter — 1 key for all models (GPT, Claude, Gemini, Kimi, DeepSeek, Qwen)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional direct provider keys (not required if using routers above)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ── Payment (Midtrans) ──
# Get from: Midtrans Dashboard > Settings > Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Set to "true" for production, leave empty/false for sandbox
MIDTRANS_IS_PRODUCTION=false

# ── Cache / Rate limit (Upstash Redis) — optional ──
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Auth / MFA secret (REQUIRED) ──
# Signs the MFA gate cookie. Generate with: openssl rand -base64 48
AUTH_MFA_SECRET=
# Optional: days before the email OTP must be re-entered (default 7)
MFA_COOKIE_MAX_AGE_DAYS=7

# ── Analytics (PostHog) — optional ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Monitoring (Sentry) — optional ──
SENTRY_DSN=
